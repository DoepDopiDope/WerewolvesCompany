<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <LethalCompanyDir Condition="'$(LethalCompanyDir)' == ''">G:\Gotta Go Fast\Steam\steamapps\common\Lethal Company</LethalCompanyDir>
    <LethalCompanyManagedDir>$(LethalCompanyDir)\Lethal Company_Data\Managed</LethalCompanyManagedDir>
    <BepInExDir>$(LethalCompanyDir)\BepInEx</BepInExDir>
