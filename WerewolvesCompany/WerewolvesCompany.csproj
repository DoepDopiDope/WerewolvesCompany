    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(LethalCompanyManagedDir)\Unity.Netcode.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(LethalCompanyManagedDir)\Unity.TextMeshPro.dll</HintPath>
